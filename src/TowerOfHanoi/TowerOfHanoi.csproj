<?xml version="1.0" encoding="utf-8"?>
<!--
  Tower of Hanoi - .NET Framework 4.8 console application.

  This project targets net48 intentionally to represent a legacy codebase that
  will later be modernized (e.g. to .NET 8/9). On macOS it is built and run via
  Mono. A reliable Mono build is also provided through build.sh (mcs), while this
  .csproj is kept as the canonical project file for the future modernization.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>TowerOfHanoi</RootNamespace>
    <AssemblyName>TowerOfHanoi</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>7.2</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Domain\PegId.cs" />
    <Compile Include="Domain\Move.cs" />
    <Compile Include="Domain\MoveError.cs" />
    <Compile Include="Domain\MoveResult.cs" />
    <Compile Include="Domain\Peg.cs" />
    <Compile Include="Domain\Board.cs" />
    <Compile Include="Domain\GameState.cs" />
    <Compile Include="Domain\HanoiSolver.cs" />
    <Compile Include="Presentation\ColorSupport.cs" />
    <Compile Include="Presentation\AnsiColor.cs" />
    <Compile Include="Presentation\IRenderer.cs" />
    <Compile Include="Presentation\ConsoleRenderer.cs" />
    <Compile Include="Presentation\IInputReader.cs" />
    <Compile Include="Presentation\PlayerCommand.cs" />
    <Compile Include="Presentation\ConsoleInputReader.cs" />
    <Compile Include="Application\GameMode.cs" />
    <Compile Include="Application\GameOptions.cs" />
    <Compile Include="Application\GameController.cs" />
    <Compile Include="Application\AutoSolverRunner.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" Condition="Exists('$(MSBuildToolsPath)\Microsoft.CSharp.targets')" />
</Project>
